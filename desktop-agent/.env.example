# Gesture Control AI — Desktop Agent
# Copy this file to .env and configure

# Server Configuration
HOST=127.0.0.1
PORT=8765

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=change-me-to-a-random-token
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Engine (Optional)
AI_PROVIDER=none
# AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Rate Limiting
MAX_COMMANDS_PER_SECOND=30
MAX_CURSOR_MOVES_PER_SECOND=60

# Safety
MAX_CURSOR_JUMP_PIXELS=500
REQUIRE_CONFIRMATION_FOR=lock_screen,close_application
